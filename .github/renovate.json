{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "1 day",
  "enabledManagers": [
    "pep621"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "packageRules": [
    {
      "description": "Dependabot manages regular uv dependency updates",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    },
    {
      "description": "Review lockfile maintenance updates",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null,
      "automerge": false
    }
  ]
}
